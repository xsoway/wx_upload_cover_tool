# ============================================================
# 公众号封面生成工具 · .gitignore
# 屏蔽本地敏感/生成文件，确保公开仓库干净安全
# ============================================================

# ---- 敏感凭据：绝不上传 ----
# config.ini 内含微信 APPID / SECRET，务必只保留本地模板
config/
*.ini
*.env
.env*

# ---- 运行时生成物 ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
*.log

outputs/
logs/

# ---- 归档旧实现（含历史个人代码/样式，不对外发布）----
archive/

# ---- 虚拟环境 ----
.venv/
venv/
env/

# ---- 系统 / IDE / OS ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp